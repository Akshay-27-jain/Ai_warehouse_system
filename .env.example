# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=warehouse_db
DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD

# Flask / JWT
SECRET_KEY=replace-with-a-strong-32-byte-secret-key
JWT_SECRET_KEY=replace-with-a-strong-32-byte-jwt-secret
FLASK_ENV=development

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SMTP (optional, fallback if Gmail OAuth not configured)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_EMAIL@gmail.com
MAIL_PASSWORD=YOUR_SMTP_APP_PASSWORD
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=no-reply@aiwarehouse.com

# Gmail OAuth for sending emails (preferred over SMTP)
GMAIL_CLIENT_ID=your-gmail-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
GMAIL_USER_EMAIL=YOUR_EMAIL@gmail.com
GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token

# Google OAuth for web sign-in (uses GMAIL_CLIENT_ID/SECRET as fallback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000
